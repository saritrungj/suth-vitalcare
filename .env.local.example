# Local development overrides
# Keep secrets in .env. This file only documents local toggles.

NODE_ENV=development
PORT=5001
VITE_API_URL=/api

# Local default: disable Cloudflare Turnstile so the app runs without external captcha setup.
# Use npm run dev:turnstile to enable it locally.
VITE_TURNSTILE_ENABLED=false
TURNSTILE_ENABLED=false

# Optional local LIFF/Turnstile values. Leave blank if you only test email/admin flows.
VITE_LIFF_ID=
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
